using UnityEngine;

// Gestion du score global du jeu
public class ScoreManager : MonoBehaviour
{
    // Singleton pour accéder facilement au score depuis tous les scripts
    public static ScoreManager instance;

    [Header("Score")]
    public int score = 0; // score actuel du joueur

    void Awake()
    {
        // initialise le singleton
        instance = this;
    }

    // ajoute du score
    public void AddScore(int amount)
    {
        score += amount;

        Debug.Log("Score: " + score);
    }
}